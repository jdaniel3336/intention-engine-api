# Postgres connection string. Locally, e.g.:
# postgresql://postgres:postgres@localhost:5432/intention_engine
# Railway injects DATABASE_URL automatically when you attach a Postgres plugin.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intention_engine

# Long random secret used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

# LLM provider: "anthropic" or "openai"
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Optional — defaults to a sensible model per provider if unset
LLM_MODEL=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
